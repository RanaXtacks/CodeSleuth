# ============================================================
# CodeSleuth / GitMentor — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example gets committed.
# ============================================================

# === Required for Member A (Backend / AI Pipeline) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === Required for Member C (Phase 3: GitHub PR fetching) ===
# Get a Personal Access Token at: https://github.com/settings/tokens
# Scopes needed: repo (private repos) or public_repo (public only)
# GITHUB_TOKEN=ghp_your_github_pat_here

# === App Settings ===
APP_ENV=development
LOG_LEVEL=INFO

# === Limits ===
DIFF_LINE_LIMIT=2000

# === Semgrep (Phase 1 — static analysis timeout in seconds) ===
SEMGREP_TIMEOUT=30

# === Sandbox (Phase 2 — test execution timeout in seconds) ===
SANDBOX_TIMEOUT=15
