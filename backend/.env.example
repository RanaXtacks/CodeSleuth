# ============================================================
# CodeSleuth / GitMentor — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example gets committed.
# ============================================================

# === Required for Member A (Backend / AI Pipeline) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === Required for Member C (Integrations / Infra) — uncomment when ready ===
# GITHUB_TOKEN=your_github_pat_here

# === App Settings ===
APP_ENV=development
LOG_LEVEL=INFO

# Max diff lines accepted (returns 413 if exceeded)
DIFF_LINE_LIMIT=2000
